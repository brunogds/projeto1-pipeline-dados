<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="indicadores.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="1459"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="indicadores" custom_title="0" dock_id="1" table="4,11:mainindicadores"/><dock_state state="000000ff00000000fd00000001000000020000000000000000fc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000ffffffff0000011800ffffff000000000000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings/></tab_browse><tab_sql><sql name="SQL 1*">SELECT data, valor
FROM indicadores
WHERE serie = 'ipca_mensal'
ORDER BY valor DESC
LIMIT 3;</sql><sql name="SQL 2*">SELECT
    CASE
        WHEN substr(data, 6, 2) BETWEEN '01' AND '03' THEN 'Q1'
        WHEN substr(data, 6, 2) BETWEEN '04' AND '06' THEN 'Q2'
        WHEN substr(data, 6, 2) BETWEEN '07' AND '09' THEN 'Q3'
        ELSE 'Q4'
    END AS trimestre,
    ROUND(AVG(valor), 4) AS dolar_medio,
    ROUND(MIN(valor), 4) AS dolar_min,
    ROUND(MAX(valor), 4) AS dolar_max
FROM indicadores
WHERE serie = 'dolar_comercial'
GROUP BY trimestre
ORDER BY trimestre;</sql><sql name="SQL 3*">SELECT
    ROUND(
        (POWER(1 + SUM(CASE WHEN serie = 'ipca_mensal'
                       THEN valor/100 ELSE 0 END), 1) - 1) * 100
    , 2) AS ipca_acumulado_pct
FROM indicadores
WHERE serie = 'ipca_mensal';</sql><current_tab id="1"/></tab_sql></sqlb_project>
